rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User profile (public-readable basics)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;

      match /likes/{trackId} {
        allow read: if isMe(uid);
        allow write: if false;
      }
      match /history/{eventId} {
        allow read: if isMe(uid);
        allow write: if false;
      }
      match /onboarding/{docId} {
        allow read: if isMe(uid);
        allow write: if false;
      }
    }

    // Public catalog
    match /tracks/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /artists/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Playlists — visibility-aware reads
    match /playlists/{id} {
      allow read: if resource.data.visibility == "public"
                  || (request.auth != null
                      && (resource.data.ownerId == request.auth.uid
                          || request.auth.uid in resource.data.collaborators));
      allow write: if false;
    }

    // Social
    match /follows/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /activity/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /comments/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /reports/{id} {
      allow read, write: if false;
    }

    // Internal — backend only
    match /cache/{id} {
      allow read, write: if false;
    }
    match /rate_limits/{id} {
      allow read, write: if false;
    }
    match /collaborator_invites/{id} {
      allow read: if request.auth != null
                  && (resource.data.inviterId == request.auth.uid
                      || resource.data.inviteeId == request.auth.uid);
      allow write: if false;
    }
  }
}
